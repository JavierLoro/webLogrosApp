generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Logro {
  id     Int    @id @default(autoincrement())
  nombre String
  puntos Int
  descripcion String
  categoria String
  icono String
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  role String @default("USER")
  logros
}

model UserLogros{
  id Int @id @default(autoincrement())
  user Int
  logro Int

}
