generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 📚 Cada "model" = una tabla. Prisma genera el cliente tipado a partir de esto, y cada
//    cambio aquí se materializa en la BD con una migración (npx prisma migrate dev).

model User {
  id                 Int              @id @default(autoincrement())
  // 📚 @unique: no puede haber dos usuarios con el mismo email (lo aprovechamos en register).
  email              String           @unique
  // 📚 Estos campos son nullable para migrar cuentas antiguas sin inventar datos; el registro
  //    nuevo y la edición de perfil sí los exigen en el borde HTTP.
  firstName          String?
  lastName           String?
  // 📚 Guardamos el HASH de bcrypt, nunca la contraseña en claro (ver routes/auth.ts).
  password           String
  logrosGanados      UserLogro[]
  memberships        TeamMembership[]
  invitationsCreated TeamInvitation[] @relation("InvitationCreator")
  // 📚 SUPER_ADMIN es un permiso global: vive en User porque no depende de la
  //    membresía ni del rol contextual que esta persona tenga dentro de cada equipo.
  isSuperAdmin       Boolean          @default(false)
  teamRequests       TeamRequest[]
  solicitudesLogro   SolicitudLogro[]
  propuestasLogro    PropuestaLogro[]
  achievementProgress AchievementProgress[]
  borradores         AchievementDraft[]
  mediaJobs          MediaJob[]
}

// 📚 Team = el "tenant" (inquilino) de la multi-tenancy. Todo cuelga de un equipo.
model Team {
  id          Int              @id @default(autoincrement())
  // 📚 slug = identificador PÚBLICO de la URL (/equipos/leones). @unique: es por donde se busca
  //    el equipo y dos equipos no pueden compartirlo. Se usa en vez del id para no filtrar
  //    cuántos equipos hay (/equipos/1 revelaría el orden de creación).
  slug        String           @unique
  nombre      String
  // 📚 Lado "uno" de la relación 1:N. VIRTUAL (no es columna): permite team.logros para traer
  //    todos los logros del equipo. El [] indica "muchos".
  logros      Logro[]
  miembros    TeamMembership[]
  invitations TeamInvitation[]
  propuestas  PropuestaLogro[]
  seasons     Season[]
  mediaJobs   MediaJob[]
  mediaAssets MediaAsset[]
  borradores AchievementDraft[]
}

enum SeasonStatus {
  PLANNED
  ACTIVE
  CLOSED
}

// 📚 Season pertenece al tenant: conserva el periodo y su estado aunque otra temporada
// 📚 pase a ser la activa, de modo que rankings y concesiones antiguas sigan siendo auditables.
model Season {
  id        Int              @id @default(autoincrement())
  teamId    Int
  name      String
  startsAt  DateTime
  endsAt    DateTime
  status    SeasonStatus     @default(PLANNED)
  createdAt DateTime         @default(now())
  team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  awards    UserLogro[]
  requests  SolicitudLogro[]
  progress  AchievementProgress[]

  @@unique([teamId, name])
  @@index([teamId, status])
}

enum TeamRole {
  TEAM_ADMIN
  PLAYER
}

// 📚 Una solicitud usa una máquina de estados: empieza pendiente y solo puede terminar
//    aceptada o rechazada por el SUPER_ADMIN.
enum TeamRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum SolicitudLogroStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// 📚 La solicitud pertenece a un User autenticado; así, al aceptarla, una transacción
//    podrá crear el equipo y convertir al solicitante en su TEAM_ADMIN sin confiar en un email.
model TeamRequest {
  id            Int               @id @default(autoincrement())
  userId        Int
  teamName      String
  // 📚 El correo oficial aporta una señal para la revisión manual; guardarlo no demuestra
  //    por sí solo que el solicitante controle ese buzón.
  officialEmail String
  message       String?
  status        TeamRequestStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  reviewedAt    DateTime?
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 📚 Índice compuesto para la consulta principal del panel: filtrar por estado y
  //    mostrar primero las solicitudes más antiguas sin recorrer y ordenar toda la tabla.
  @@index([status, createdAt])
}

// 📚 La membresía convierte la relación User↔Team en N:N: el rol vive aquí porque puede
//    cambiar según el equipo y la clave compuesta evita duplicar una pertenencia.
model TeamMembership {
  id          Int      @id @default(autoincrement())
  userId      Int
  teamId      Int
  role        TeamRole @default(PLAYER)
  // 📚 El alias pertenece a la relación persona-equipo: una misma cuenta puede mostrarse
  //    de forma distinta en cada tenant sin duplicar su identidad global.
  displayName String?
  joinedAt    DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
}

// 📚 Guardamos el hash del código y no el token en claro: si alguien lee la BD no puede
//    reutilizar directamente una invitación activa. expiresAt/revokedAt permiten gobernar su ciclo de vida.
model TeamInvitation {
  id              Int       @id @default(autoincrement())
  teamId          Int
  createdById     Int
  tokenHash       String    @unique
  // 📚 El hash sirve para validar; la copia cifrada permite que un administrador vuelva a
  //    consultar el código sin almacenarlo en claro. Es opcional por compatibilidad con invitaciones antiguas.
  tokenCiphertext String?
  expiresAt       DateTime
  revokedAt       DateTime?
  maxUses         Int       @default(1)
  uses            Int       @default(0)
  createdAt       DateTime  @default(now())
  team            Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy       User      @relation("InvitationCreator", fields: [createdById], references: [id])

  @@index([teamId])
}

// 📚 Logro = INSTANCIA del catálogo de UN equipo (la plantilla comunitaria proponible es otra
//    tabla, en Phase 8.5). Relación 1:N con Team: muchos logros pertenecen a un equipo.
model Logro {
  id          Int              @id @default(autoincrement())
  // 📚 Permite ordenar altas reales; la migración usa su fecha como backfill, no una fecha histórica inventada.
  createdAt   DateTime         @default(now())
  nombre      String
  puntos      Int
  // 📚 El array conserva el orden de criterios al incorporar una propuesta al catálogo.
  criterios   String[]         @default([])
  // 📚 El ? = campo OPCIONAL (columna admite NULL). Adornos que pueden faltar.
  descripcion String?
  categoria   String?
  icono       String? // emoji, p.ej. "🏆"
  // 📚 El alcance pertenece a la definición del logro: PERMANENT se obtiene una vez;
  // 📚 SEASONAL puede volver a obtenerse en cada temporada sin duplicar el catálogo.
  scope       AchievementScope @default(PERMANENT)
  // 📚 Tipo, visibilidad y alcance son dimensiones independientes; el default conserva el catálogo antiguo.
  kind        AchievementKind  @default(STANDARD)
  isSecret    Boolean          @default(false)
  targetValue Int?
  // 📚 teamId = la CLAVE FORÁNEA real (columna en la BD). Sin ? → OBLIGATORIA: no hay logros
  //    huérfanos, todo logro pertenece a un equipo (regla de la multi-tenancy).
  teamId      Int
  // 📚 team = campo de NAVEGACIÓN (virtual, no columna). @relation conecta teamId → Team.id, y
  //    permite logro.team / include: { team: true }. Prisma exige los DOS lados (aquí y en Team).
  team        Team             @relation(fields: [teamId], references: [id])
  obtenidos   UserLogro[]
  solicitudes SolicitudLogro[]
  propuesta   PropuestaLogro?
  progress    AchievementProgress[]
  // 📚 La clave compuesta con teamId impide asociar desde Prisma un asset de otro tenant.
  imageAssetId String?           @db.Uuid
  imageAsset   MediaAsset?       @relation(fields: [teamId, imageAssetId], references: [teamId, id], onDelete: Restrict)

  @@unique([teamId, imageAssetId])
}

enum AchievementScope {
  PERMANENT
  SEASONAL
}

enum AchievementKind {
  STANDARD
  PROGRESSIVE
}

// 📚 El contador pertenece al jugador y al periodo, nunca a la definición ni a la concesión.
// 📚 Los índices parciales de la migración impiden duplicados también cuando seasonId es NULL.
model AchievementProgress {
  id           Int      @id @default(autoincrement())
  userId       Int
  logroId      Int
  seasonId     Int?
  currentValue Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  logro        Logro    @relation(fields: [logroId], references: [id], onDelete: Cascade)
  season       Season?  @relation(fields: [seasonId], references: [id], onDelete: Restrict)

  @@index([logroId])
  @@index([seasonId])
}

enum PropuestaLogroStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// 📚 Proponer no es obtener: este registro enlaza catálogo solo tras aprobación y nunca UserLogro.
model PropuestaLogro {
  id              Int                  @id @default(autoincrement())
  teamId          Int
  userId          Int
  nombre          String
  descripcion     String
  criterios       String[]
  status          PropuestaLogroStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime             @default(now())
  reviewedAt      DateTime?
  logroId         Int?                 @unique
  team            Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  logro           Logro?               @relation(fields: [logroId], references: [id], onDelete: Restrict)

  imageAssetId String? @db.Uuid
  imageAsset MediaAsset? @relation(fields: [teamId, imageAssetId], references: [teamId, id], onDelete: Restrict, map: "PropuestaLogro_imageAsset_fkey")
  // 📚 Solo la migración marca pendientes antiguas; las propuestas nuevas no admiten subsanación.
  imageRepairAllowed Boolean @default(false)

  @@unique([teamId, imageAssetId])
  // 📚 Los dos índices corresponden a cola administrativa e historial propio dentro del tenant.
  @@index([teamId, status, createdAt])
  @@index([teamId, userId, createdAt])
}

// 📚 No duplicamos teamId: el tenant se obtiene mediante logro.teamId, evitando que una
//    solicitud pueda declarar un equipo distinto del propietario real del logro.
model SolicitudLogro {
  id              Int                  @id @default(autoincrement())
  userId          Int
  logroId         Int
  seasonId        Int?
  status          SolicitudLogroStatus @default(PENDING)
  createdAt       DateTime             @default(now())
  reviewedAt      DateTime?
  // 📚 Nullable conserva resoluciones antiguas sin inventar motivos; los rechazos nuevos lo exigen.
  rejectionReason String?
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  logro           Logro                @relation(fields: [logroId], references: [id], onDelete: Cascade)
  season          Season?              @relation(fields: [seasonId], references: [id], onDelete: Restrict)

  // 📚 No usamos @@unique([userId, logroId]): tras un rechazo se puede volver a solicitar;
  //    los índices aceleran la bandeja del jugador y la cola administrativa por estado.
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([seasonId])
}

model UserLogro {
  id       Int      @id @default(autoincrement())
  userId   Int
  logroId  Int
  seasonId Int?
  fecha    DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])
  logro    Logro    @relation(fields: [logroId], references: [id])
  season   Season?  @relation(fields: [seasonId], references: [id], onDelete: Restrict)

  // 📚 La unicidad depende de si seasonId es NULL; PostgreSQL la aplica con dos índices
  // 📚 parciales definidos en la migración, algo que Prisma Schema aún no puede expresar.
  @@index([seasonId])
}

// 📚 Estos estados describen el trabajo técnico de imagen, no el estado de una
// 📚 propuesta. La transición/cancelación se conectará al ejecutor en otro bloque.
enum MediaJobState {
  RECEIVING
  QUEUED
  PROCESSING
  PUBLISHING
  SUCCEEDED
  FAILED
  CANCELED
  INTERRUPTED
}

// 📚 El owner identifica una vida concreta del runtime, no una sesión de usuario;
// 📚 el advisory lock protege la exclusividad y este registro permite recuperar tras reinicio.
model MediaRuntimeOwner {
  id            String      @id @default(uuid()) @db.Uuid
  hostId        String      @db.VarChar(255)
  // 📚 La migración exige processId > 0: cero no es un PID verificable.
  processId     Int
  temporaryRoot String      @db.VarChar(2048)
  startedAt     DateTime    @default(now()) @db.Timestamp(3)
  closedAt      DateTime?   @db.Timestamp(3)
  jobs          MediaJob[]
  orphanCleanups MediaOrphanCleanup[]

  @@index([hostId, processId, startedAt])
  @@index([closedAt, startedAt])
}

enum MediaOrphanCleanupStatus {
  PENDING
  COMPLETE
}

// 📚 El journal se persiste antes de retirar archivos sin MediaJob, para que un reinicio pueda reanudar exactamente ese workspace.
model MediaOrphanCleanup {
  id              String                    @id @default(uuid()) @db.Uuid
  jobId           String                    @unique @db.Uuid
  runtimeOwnerId  String                    @db.Uuid
  receiptToken    String                    @db.Uuid
  temporaryRoot   String                    @db.VarChar(2048)
  path            String                    @db.VarChar(2048)
  status          MediaOrphanCleanupStatus  @default(PENDING)
  attempts        Int                       @default(0)
  lastErrorCode   String?
  lastActivityAt  DateTime                  @default(now()) @db.Timestamp(3)
  completedAt     DateTime?                 @db.Timestamp(3)
  createdAt       DateTime                  @default(now()) @db.Timestamp(3)
  updatedAt       DateTime                  @updatedAt @db.Timestamp(3)
  runtimeOwner    MediaRuntimeOwner         @relation(fields: [runtimeOwnerId], references: [id], onDelete: Restrict)

  @@index([status, lastActivityAt])
}

// 📚 El registro conserva propietario, destino y estado aunque cierre la página.
// 📚 Admisión/toma viven en el dominio; rutas HTTP, receptor y almacenamiento siguen fuera de este bloque.
model MediaJob {
  id                String        @id @default(uuid()) @db.Uuid
  ownerId           Int
  teamId            Int?
  resourceKey       String        @db.VarChar(255)
  // 📚 UNIQUE nullable reserva el destino mientras el trabajo siga activo. La
  // 📚 migración añade CHECK para impedir liberarlo solo cambiando este campo a null.
  activeResourceKey String?       @unique @db.VarChar(255)
  status            MediaJobState @default(RECEIVING)
  // 📚 La solicitud se conserva aunque el proceso siga escribiendo; solo el dueño del cierre seguro libera el destino.
  cancelRequestedAt DateTime?     @db.Timestamp(3)
  // 📚 La espera FIFO empieza al cerrar recepción; una transferencia lenta aún no ha llegado a la cola.
  queuedAt          DateTime?
  // 📚 Este plazo libera solo una reserva QUEUED; nunca supone que un stream RECEIVING se haya cerrado.
  queueExpiresAt    DateTime?
  // 📚 Los dos puestos representan capacidad global; UNIQUE evita que un error de
  // 📚 coordinación asigne el mismo puesto a dos trabajos activos.
  processingSlot    Int?          @unique
  // 📚 El UUID cambia en cada toma: identifica qué intento puede actuar sobre el trabajo.
  executionToken    String?       @db.Uuid
  processingStartedAt DateTime?
  // 📚 NULL conserva trabajos de versiones anteriores; nunca se interpreta como dueño muerto.
  runtimeOwnerId    String?       @db.Uuid
  // 📚 Cada lease de recepción queda asociado a un UUID propio para distinguir
  // 📚 streams vivos de recepciones abandonadas durante una caída del proceso.
  // 📚 La migración exige owner cuando hay receiptId y PID/ruta de worker emparejados.
  runtimeReceiptId  String?       @db.Uuid
  workerPid         Int?
  // 📚 La ruta variants-* exacta se persiste antes del fork para poder limpiar solo ese intento tras un reinicio.
  workerDirectory   String?       @db.VarChar(2048)
  // 📚 Este token identifica qué recepción está autorizada a escribir y confirmar el recibo.
  receiptToken      String?       @db.Uuid
  receiptStartedAt  DateTime?
  // 📚 El marcador one-shot CAS impide arrancar dos workers para la misma toma.
  executorStartedAt DateTime?
  // 📚 Este CAS hace one-shot la publicación remota, aunque el worker reciba el mismo claim otra vez.
  publisherStartedAt DateTime?
  imageKind         String?       @db.VarChar(24)
  inputDirectory    String?       @db.VarChar(2048)
  resultDirectory   String?       @db.VarChar(2048)
  resultManifest    Json?
  cleanupPendingDirectory String? @db.VarChar(2048)
  // 📚 El path histórico se conserva; este marcador permite al reconciliador dejar
  // 📚 de revisar trabajos terminales cuya eliminación física ya quedó confirmada.
  // 📚 La migración solo permite marcarlo cuando el trabajo está terminal.
  temporaryCleanedAt DateTime?   @db.Timestamp(3)
  failureCode       String?       @db.VarChar(64)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  completedAt       DateTime?
  // 📚 Restrict evita borrar el propietario/equipo mientras haya trabajos referidos;
  // 📚 las futuras operaciones de baja deben coordinar sus trabajos y limpieza.
  owner             User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  team              Team?         @relation(fields: [teamId], references: [id], onDelete: Restrict)
  runtimeOwner      MediaRuntimeOwner? @relation(fields: [runtimeOwnerId], references: [id], onDelete: Restrict)
  asset             MediaAsset?

  @@index([ownerId, createdAt])
  @@index([teamId, status])
  @@index([status, createdAt])
  @@index([status, queuedAt, id])
  @@index([runtimeOwnerId, status])
  @@index([runtimeOwnerId, runtimeReceiptId, status])
  @@index([runtimeOwnerId, cancelRequestedAt, status])
  @@index([status, temporaryCleanedAt, completedAt])
}

enum MediaAssetState {
  STAGING
  READY
  RETIRED
}

enum MediaAssetCleanupStatus {
  PENDING
  COMPLETE
}

// 📚 Un asset es una versión privada e inmutable; Logro solo apunta a ella al completar la publicación.
model MediaAsset {
  id          String          @id @default(uuid()) @db.Uuid
  jobId       String          @unique @db.Uuid
  teamId      Int
  state       MediaAssetState @default(STAGING)
  variants    Json
  createdAt   DateTime        @default(now())
  job         MediaJob        @relation(fields: [jobId], references: [id], onDelete: Restrict)
  team        Team            @relation(fields: [teamId], references: [id], onDelete: Restrict)
  achievement Logro?
  draft AchievementDraft?
  proposal PropuestaLogro?
  cleanup     MediaAssetCleanup?

  // 📚 Esta clave única permite que Logro valide el tenant y el asset en la misma FK.
  @@unique([teamId, id])
  @@index([teamId, state])
}

// 📚 Las claves se guardan antes de borrarlas para que un reinicio no pierda limpieza pendiente.
model MediaAssetCleanup {
  id            String                  @id @default(uuid()) @db.Uuid
  assetId       String                  @unique @db.Uuid
  keys          String[]
  status        MediaAssetCleanupStatus @default(PENDING)
  attempts      Int                     @default(0)
  lastErrorCode String?
  createdAt     DateTime                @default(now())
  completedAt   DateTime?
  asset         MediaAsset              @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
}


enum AchievementDraftPurpose {
  PROPOSAL
  DIRECT
}

enum AchievementDraftStatus {
  DRAFT
  SUBMITTED
  PUBLISHED
  DISCARDED
}

// 📚 El registro terminal conserva la identidad del envío para resolver un ACK perdido y rechazar workers tardíos.
model AchievementDraft {
  id String @id @default(uuid()) @db.Uuid
  userId Int
  teamId Int
  purpose AchievementDraftPurpose
  status AchievementDraftStatus @default(DRAFT)
  fields Json @default("{}")
  version Int @default(1)
  submittedVersion Int?
  resultId Int?
  imageAssetId String? @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  team Team @relation(fields: [teamId], references: [id], onDelete: Restrict)
  imageAsset MediaAsset? @relation(fields: [teamId, imageAssetId], references: [teamId, id], onDelete: Restrict, map: "AchievementDraft_imageAsset_fkey")

  @@unique([teamId, imageAssetId])
  @@index([userId, status])
  @@index([teamId, userId, status])
}
