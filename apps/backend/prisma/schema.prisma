generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Logro {
  id     Int    @id @default(autoincrement())
  nombre String
  puntos Int
  descripcion String
  categoria String
  icono String
  usuarios UserLogros[]
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  role String @default("USER")
  logros UserLogros[]
}

model UserLogros{
  id Int @id @default(autoincrement())
  userId Int 
  user User @relation(fields: [userId], references: [id])
  logroId Int
  logro Logro @relation(fields: [logroId], references: [id])
  fechaObtenido DateTime @default(now())
  @@unique([userId, logroId])

}
