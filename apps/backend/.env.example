# Copiar a .env y rellenar los valores reales
# Desarrollo local: las credenciales coinciden con docker-compose.yml
DATABASE_URL="postgresql://admin:admin123@localhost:5432/weblogros"

# Generar una cadena larga y aleatoria, p.ej.: openssl rand -hex 32
JWT_SECRET="cambiame-por-una-cadena-larga-y-aleatoria"

# Solo cuando se active media: conexión privada desde el backend al bucket S3.
# En producción, usar el nombre interno del servicio y credenciales distintas.
S3_ENDPOINT="http://127.0.0.1:8333"
S3_REGION="us-east-1"
S3_BUCKET="lockerboard-media-dev"
S3_FORCE_PATH_STYLE="true"
AWS_ACCESS_KEY_ID="rellenar-localmente"
AWS_SECRET_ACCESS_KEY="rellenar-localmente"

# Activación explícita: false permite arrancar el backend sin infraestructura media.
# Con true se comprueban DB, bucket y disco ANTES de abrir el puerto HTTP.
MEDIA_ENABLED="false"
# Ruta absoluta, dedicada y privada. No usar carpetas de código ni archivos existentes.
# Windows local: C:/Users/tu-usuario/proyecto/apps/backend/.media-tmp
# Linux: ruta del volumen temporal del backend (se configura al preparar despliegue).
MEDIA_TEMP_ROOT=""
# Origins exactos separados por coma, sin barra final. Requerido en producción.
# Desarrollo permite estos dos por defecto; no autoriza lectura anónima del bucket.
# También protege guardar borradores/revisar propuestas aunque MEDIA_ENABLED=false.
MEDIA_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
